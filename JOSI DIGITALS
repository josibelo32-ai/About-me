<!DOCTYPE html>
<html lang="en" data-lang="both">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Yosef Belachew – Developer & Social Media Manager</title>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@500;800&family=Inter:wght@400;500&family=Noto+Sans+Ethiopic:wght@400;700&display=swap" rel="stylesheet">
<style>
:root{--bg:#0a1f22;--surface:#0f2f33;--text:#f3ece2;--muted:#9bb8b6;--accent:#e39a5c;--line:#1f4a4f;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:light){:root:not([data-theme="dark"]){--bg:#f6efe4;--surface:#ebe1d1;--text:#12302f;--muted:#4d6b69;--accent:#b4622a;--line:#d3c4ac}}
:root[data-theme="light"]{--bg:#f6efe4;--surface:#ebe1d1;--text:#12302f;--muted:#4d6b69;--accent:#b4622a;--line:#d3c4ac}
:root[data-theme="dark"]{--bg:#0a1f22;--surface:#0f2f33;--text:#f3ece2;--muted:#9bb8b6;--accent:#e39a5c;--line:#1f4a4f}
*{box-sizing:border-box}
html{scroll-padding-top:env(safe-area-inset-top,0px);scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--text);font:400 17px/1.6 Inter,system-ui,sans-serif;overflow-x:hidden}
main{max-width:900px;margin:0 auto;padding:0 22px}
h1,h2,h3{font-family:'Bricolage Grotesque',Inter,sans-serif;margin:0;line-height:1.02}
.hero{padding:48px 0 52px;text-align:center}
.photo{position:relative;width:min(70vw,300px);aspect-ratio:1;margin:0 auto 34px}
.photo::before{content:"";position:absolute;inset:-9px;border-radius:50%;background:conic-gradient(from 0deg,var(--accent),transparent 30%,var(--accent) 55%,transparent 80%,var(--accent));animation:spin 9s linear infinite}
.photo::after{content:"";position:absolute;inset:-4px;border-radius:50%;background:var(--bg)}
.photo img{position:relative;z-index:1;width:100%;height:100%;border-radius:50%;object-fit:cover;display:block}
.star{position:absolute;z-index:2;color:var(--accent);font-size:2rem;line-height:1}
.s1{top:-6px;right:-4px}.s2{bottom:18px;left:-18px;font-size:1.2rem}
@keyframes spin{to{transform:rotate(360deg)}}
@media (prefers-reduced-motion:reduce){.photo::before{animation:none}}
h1{font-size:clamp(3.2rem,15vw,7rem);font-weight:800;letter-spacing:-.035em}
.role{margin:20px auto 0;font-size:1.15rem;color:var(--muted);max-width:28em}
.cta{display:flex;flex-wrap:wrap;gap:12px;margin-top:28px;justify-content:center}
.btn{padding:13px 24px;border-radius:999px;text-decoration:none;font-weight:500;border:1.5px solid var(--accent);color:var(--text)}
.btn.main{background:var(--accent);color:#111}
.btn:focus-visible{outline:3px solid var(--text);outline-offset:3px}
.strip{overflow:hidden;border-block:1px solid var(--line);padding:14px 0;margin:0 -22px}
.strip div{display:flex;gap:40px;width:max-content;animation:run 26s linear infinite;font:800 1.3rem 'Bricolage Grotesque',Inter,sans-serif;white-space:nowrap}
.strip span::after{content:"✦";color:var(--accent);margin-left:40px}
@keyframes run{to{transform:translateX(-50%)}}
@media (prefers-reduced-motion:reduce){.strip div{animation:none}}
section{padding:48px 0}
h2{font-size:2.2rem;font-weight:800;margin-bottom:24px}
.grid{display:grid;gap:14px;grid-template-columns:repeat(auto-fit,minmax(250px,1fr))}
.card{background:var(--surface);border-left:4px solid var(--accent);padding:20px;border-radius:4px;transition:transform .2s}
.card:hover{transform:translateY(-4px)}
.card h3{font-size:1.2rem;margin-bottom:8px}
.card p{margin:0;color:var(--muted);font-size:.97rem}
.proj h3{font-size:1.6rem}
.tags{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}
.tags span{font-size:.85rem;padding:4px 12px;border:1px solid var(--line);border-radius:999px;color:var(--muted)}
.contact{border-top:1px solid var(--line)}
.contact a{color:var(--accent);font-weight:500}
.contact p{margin:6px 0}
footer{padding:26px 22px 40px;color:var(--muted);font-size:.9rem;text-align:center;border-top:1px solid var(--line)}

.am{display:block;font-family:'Noto Sans Ethiopic',Inter,sans-serif;color:var(--muted);font-weight:400;letter-spacing:0}
h1 .am{font-size:.3em;font-weight:700;margin-top:10px;line-height:1.3}
h2 .am,h3 .am{font-size:.62em;font-weight:700;margin-top:6px;line-height:1.35}
.role .am,.card p .am{margin-top:6px;font-size:.95em}
.btn .am{font-size:.8em;color:inherit;opacity:.85}
[data-lang="en"] .am{display:none}
[data-lang="am"] .en{display:none}
[data-lang="am"] .am{font-size:inherit!important;color:inherit!important;margin-top:0!important;font-weight:inherit!important}
[data-lang="am"] h1 .am{font-size:1em!important;font-weight:800!important}
.contact p .am{display:inline;margin-left:6px}
[data-lang="en"] .contact p .am{display:none}
.lang{display:flex;gap:6px;justify-content:center;margin:0 0 26px}
.lang button{font:500 .9rem Inter,sans-serif;padding:7px 16px;border-radius:999px;border:1.5px solid var(--line);background:none;color:var(--text);cursor:pointer}
.lang button[aria-pressed="true"]{background:var(--accent);border-color:var(--accent);color:#fff}
.lang button:focus-visible{outline:3px solid var(--text);outline-offset:2px}
</style>
</head>
